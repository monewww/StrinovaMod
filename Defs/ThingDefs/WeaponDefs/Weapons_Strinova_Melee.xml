      </li>
      <!-- 刺刀刀刃攻击（切割） -->
      <li>
        <label>edge</label> <!-- 攻击部位名称 -->
        <capacities>
          <li>Cut</li> <!-- 攻击类型：切割 -->
        </capacities>
        <power>90</power> <!-- 攻击力60 -->
        <cooldownTime>0.8</cooldownTime> <!-- 攻击冷却1.0秒 -->
        <armorPenetration>0.76</armorPenetration> <!-- 穿甲率76% -->
      </li>
    </tools>
  </ThingDef>
</Defs>